# Salin file ini menjadi .env untuk menyesuaikan konfigurasi

# Ukuran maksimum array yang boleh dianimasikan
MAX_VISUAL_ARRAY_SIZE=60

# Ukuran default array contoh
DEFAULT_ARRAY_SIZE=15

# Jeda antar-frame animasi (detik)
ANIMATION_DELAY_SECONDS=0.05

# Lebar maksimum bar chart ASCII (karakter)
MAX_BAR_WIDTH=40

# Mode verbose (true/false)
VERBOSE_MODE=false
