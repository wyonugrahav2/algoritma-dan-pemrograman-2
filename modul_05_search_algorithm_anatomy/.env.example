# Salin berkas ini menjadi ".env" dan sesuaikan nilainya sesuai kebutuhan.

# Algoritma default yang digunakan jika --algo tidak diisi di CLI.
# Pilihan: linear, binary, interpolation, exponential, hash
DEFAULT_ALGORITHM=binary

# Mengaktifkan/menonaktifkan animasi visual pergeseran pointer di terminal.
ENABLE_STEP_VISUALIZER=true

# Mengaktifkan/menonaktifkan pengukuran latensi & memori (search_profiler.py).
ENABLE_PROFILER=true

# Level logging aplikasi: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO
