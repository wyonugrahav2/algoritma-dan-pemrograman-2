# Salin berkas ini menjadi .env dan sesuaikan nilainya sesuai kebutuhan

# Ukuran rekam data per kelompok saat streaming
PIPELINE_CHUNK_SIZE=1000

# Kapasitas buffer maksimum sebelum backpressure diaktifkan
PIPELINE_BUFFER_CAPACITY=5000

# Encoding berkas input/output
PIPELINE_FILE_ENCODING=utf-8

# Delimiter default untuk berkas CSV
PIPELINE_CSV_DELIMITER=,

# Interval baris untuk melaporkan progress ke UI
PIPELINE_PROGRESS_INTERVAL=500

# Ambang batas watermark backpressure (0.0 - 1.0)
PIPELINE_HIGH_WATERMARK=0.85
PIPELINE_LOW_WATERMARK=0.40
