# Konfigurasi Hash Table
HASH_INITIAL_CAPACITY=8
HASH_LOAD_FACTOR_THRESHOLD=0.7
HASH_RESIZE_MULTIPLIER=2
HASH_COLLISION_STRATEGY=chaining   # chaining | open_addressing

# Konfigurasi Bloom Filter
BLOOM_DEFAULT_SIZE=10000
BLOOM_DEFAULT_HASH_COUNT=5
BLOOM_FALSE_POSITIVE_RATE=0.01

# Konfigurasi LRU Cache
LRU_DEFAULT_CAPACITY=128

# Konfigurasi Benchmark
BENCHMARK_REPEAT=3
