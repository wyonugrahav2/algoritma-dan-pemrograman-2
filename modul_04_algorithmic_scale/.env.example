# .env.example
# Salin file ini menjadi .env dan sesuaikan nilainya sesuai kebutuhan.
# Semua variabel bersifat opsional; jika tidak diset, nilai default
# pada config/settings.py akan digunakan.

# Batas waktu eksekusi (detik) sebelum sebuah uji dianggap timeout.
EXECUTION_TIMEOUT_SECONDS=10.0

# Batas alokasi memori (MB) sebelum sebuah uji dianggap melebihi kuota RAM.
MAX_MEMORY_MB=512.0

# Jumlah pengulangan (repeats) tiap pengukuran waktu untuk mengurangi noise.
REPEATS_PER_MEASUREMENT=3

# Seed acak default agar data sintetis dapat direproduksi.
RANDOM_SEED=42

# Direktori output laporan (Markdown/JSON).
REPORT_OUTPUT_DIR=reports

# Ukuran grafik ASCII default (karakter).
ASCII_PLOT_WIDTH=60
ASCII_PLOT_HEIGHT=15
